# Reko — Supabase project (created 2026-09-04, project ref ktpqywmtgswjmvdyvvlg)
NEXT_PUBLIC_SUPABASE_URL=https://ktpqywmtgswjmvdyvvlg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser.
# Not currently used by any route yet (all writes go through
# SECURITY DEFINER functions called with the user's own session).
# Add only if/when a genuine server-side admin operation needs it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (billing) ---------------------------------------------------
# Secret key from the Paystack dashboard (Settings -> API Keys & Webhooks).
# Use the sk_test_... key until you are ready to take real money.
# Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
PAYSTACK_SECRET_KEY=

# Plan codes (PLN_...) created under Paystack -> Plans.
# Create two: ₦1,599 monthly and ₦15,990 annually.
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_YEARLY=

# Where Paystack sends the customer back after checkout, and the base used to
# build that link. In production this is your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
